<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PoVMonsterLevels</AssemblyName>
    <Version>0.0.2</Version>
    <AssemblyVersion>0.0.2.0</AssemblyVersion>
    <FileVersion>0.0.2.0</FileVersion>
    <RootNamespace>PoVMonsterLevels</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <ValheimManaged>C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed</ValheimManaged>
    <BepInExCore>C:\Users\Usuario\AppData\Roaming\com.kesomannen.gale\valheim\profiles\testesssss\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ILRepack" Version="2.0.48" PrivateAssets="all" GeneratePathProperty="true" />
    <EmbeddedResource Include="config\creatures\*.json" LogicalName="PoVMonsterLevels.DefaultCreatureTables.%(Filename)%(Extension)" />
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ServerSync"><HintPath>lib\ServerSync.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ValheimManaged)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="PackageSingleDll" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <MergedAssembly>$(TargetDir)$(AssemblyName).merged.dll</MergedAssembly>
      <DistributionDirectory>$(MSBuildProjectDirectory)\dist</DistributionDirectory>
    </PropertyGroup>
    <Exec Command="&quot;$(PkgILRepack)\tools\ILRepack.exe&quot; /internalize /parallel /lib:&quot;$(BepInExCore)&quot; /lib:&quot;$(ValheimManaged)&quot; /out:&quot;$(MergedAssembly)&quot; &quot;$(TargetPath)&quot; &quot;$(TargetDir)ServerSync.dll&quot;" />
    <Delete Files="$(TargetPath);$(TargetDir)ServerSync.dll" />
    <Move SourceFiles="$(MergedAssembly)" DestinationFiles="$(TargetPath)" />
    <MakeDir Directories="$(DistributionDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(DistributionDirectory)\$(AssemblyName)-$(Version).dll" />
  </Target>
</Project>
